From a8bb41049b8e71d8abc67da6b09a902861d8e26d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markku=20Ahvenj=C3=A4rvi?= <mankku@gmail.com>
Date: Mon, 22 Jun 2026 14:41:44 +0300
Subject: [PATCH] DEBUG: trace IOMMU for GPU
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Markku Ahvenjärvi <mankku@gmail.com>
---
 drivers/iommu/intel/dmar.c  |   6 ++
 drivers/iommu/intel/iommu.c | 200 +++++++++++++++++++++++++++++++++++-
 drivers/iommu/intel/iommu.h |   3 +
 include/linux/dmar.h        |   5 -
 4 files changed, 206 insertions(+), 8 deletions(-)

diff --git a/drivers/iommu/intel/dmar.c b/drivers/iommu/intel/dmar.c
index ec64a3917eb6..1f1d0ed2138e 100644
--- a/drivers/iommu/intel/dmar.c
+++ b/drivers/iommu/intel/dmar.c
@@ -1942,6 +1942,12 @@ static int dmar_fault_do_one(struct intel_iommu *iommu, int type,
 		       PCI_FUNC(source_id & 0xFF), addr,
 		       fault_reason, reason);
 
+	if (intel_iommu_debug_should_dump_source_id(source_id)) {
+		pr_err("DMAR debug: iommu=%s source_id=%04x pasid=%#x addr=%#llx type=%s\n",
+		       iommu->name, source_id, pasid, addr,
+		       type ? "read" : "write");
+	}
+
 	dmar_fault_dump_ptes(iommu, source_id, addr, pasid);
 
 	return 0;
diff --git a/drivers/iommu/intel/iommu.c b/drivers/iommu/intel/iommu.c
index 8aa7e7ae2df5..99dacb5ec781 100644
--- a/drivers/iommu/intel/iommu.c
+++ b/drivers/iommu/intel/iommu.c
@@ -212,6 +212,8 @@ static int intel_iommu_superpage = 1;
 static int iommu_identity_mapping;
 static int iommu_skip_te_disable;
 static int disable_igfx_iommu;
+static bool intel_iommu_debug_dump_all_domains;
+static int intel_iommu_debug_dump_source_id = PCI_DEVID(0, 2);
 
 #define IDENTMAP_AZALIA		4
 
@@ -237,6 +239,33 @@ static void init_translation_status(struct intel_iommu *iommu)
 		iommu->flags |= VTD_FLAG_TRANS_PRE_ENABLED;
 }
 
+static int __init intel_iommu_parse_debug_source_id(const char *str, int *source_id)
+{
+	unsigned int bus, slot, func, id;
+
+	if (!strcmp(str, "none")) {
+		*source_id = -1;
+		return 0;
+	}
+
+	if (sscanf(str, "%x:%x.%x", &bus, &slot, &func) == 3) {
+		if (bus > U8_MAX || slot > 0x1f || func > 0x7)
+			return -EINVAL;
+
+		*source_id = PCI_DEVID(bus, PCI_DEVFN(slot, func));
+		return 0;
+	}
+
+	if (kstrtouint(str, 0, &id))
+		return -EINVAL;
+
+	if (id > U16_MAX)
+		return -EINVAL;
+
+	*source_id = id;
+	return 0;
+}
+
 static int __init intel_iommu_setup(char *str)
 {
 	if (!str)
@@ -268,6 +297,23 @@ static int __init intel_iommu_setup(char *str)
 		} else if (!strncmp(str, "sm_off", 6)) {
 			pr_info("Scalable mode is disallowed\n");
 			intel_iommu_sm = 0;
+		} else if (!strncmp(str, "debug_dump_all_domains", 22)) {
+			pr_info("DMAR debug: dump all domains enabled\n");
+			intel_iommu_debug_dump_all_domains = true;
+		} else if (!strncmp(str, "debug_dump_source=", 18)) {
+			int ret;
+
+			ret = intel_iommu_parse_debug_source_id(str + 18,
+								&intel_iommu_debug_dump_source_id);
+			if (ret) {
+				pr_notice("Invalid DMAR debug dump source - '%s'\n",
+					  str + 18);
+			} else if (intel_iommu_debug_dump_source_id < 0) {
+				pr_info("DMAR debug: specific dump source disabled\n");
+			} else {
+				pr_info("DMAR debug: dump source id %#x selected\n",
+					intel_iommu_debug_dump_source_id);
+			}
 		} else if (!strncmp(str, "tboot_noforce", 13)) {
 			pr_info("Intel-IOMMU: not forcing on after tboot. This could expose security risk for tboot\n");
 			intel_iommu_tboot_noforce = 1;
@@ -284,6 +330,14 @@ static int __init intel_iommu_setup(char *str)
 }
 __setup("intel_iommu=", intel_iommu_setup);
 
+static bool intel_iommu_debug_match_bus_devfn(u8 bus, u8 devfn)
+{
+	if (intel_iommu_debug_dump_source_id < 0)
+		return false;
+
+	return intel_iommu_debug_dump_source_id == PCI_DEVID(bus, devfn);
+}
+
 static int domain_pfn_supported(struct dmar_domain *domain, unsigned long pfn)
 {
 	int addr_width = agaw_to_width(domain->agaw) - VTD_PAGE_SHIFT;
@@ -723,8 +777,8 @@ static void pgtable_walk(struct intel_iommu *iommu, unsigned long pfn,
 	}
 }
 
-void dmar_fault_dump_ptes(struct intel_iommu *iommu, u16 source_id,
-			  unsigned long long addr, u32 pasid)
+static void __dmar_fault_dump_ptes(struct intel_iommu *iommu, u16 source_id,
+				   unsigned long long addr, u32 pasid)
 {
 	struct pasid_dir_entry *dir, *pde;
 	struct pasid_entry *entries, *pte;
@@ -816,6 +870,131 @@ void dmar_fault_dump_ptes(struct intel_iommu *iommu, u16 source_id,
 }
 #endif
 
+bool intel_iommu_debug_should_dump_source_id(u16 source_id)
+{
+	if (intel_iommu_debug_dump_source_id >= 0)
+		return source_id == intel_iommu_debug_dump_source_id;
+
+	return intel_iommu_debug_dump_all_domains;
+}
+
+static bool intel_iommu_debug_should_dump_domain(struct dmar_domain *domain)
+{
+	struct device_domain_info *info;
+
+	if (intel_iommu_debug_dump_source_id < 0)
+		return intel_iommu_debug_dump_all_domains;
+
+	list_for_each_entry(info, &domain->devices, link) {
+		if (intel_iommu_debug_match_bus_devfn(info->bus, info->devfn))
+			return true;
+	}
+
+	return false;
+}
+
+void intel_iommu_debug_dump_pte_chain(struct dmar_domain *domain,
+				      unsigned long iova)
+{
+	struct dma_pte *pte = NULL, *parent = domain->pgd;
+	unsigned long pfn = iova >> VTD_PAGE_SHIFT;
+	int level = agaw_to_level(domain->agaw);
+
+	pr_err("DMAR debug: dump domain=%px iova=%#lx gaw=%u agaw=%u pgd=%px\n",
+	       domain, iova, domain->gaw, domain->agaw, domain->pgd);
+
+	while (parent) {
+		int offset = pfn_level_offset(pfn, level);
+
+		pte = &parent[offset];
+		pr_err("DMAR debug: level=%d offset=%d pte=%px val=%#016llx present=%d large=%d addr=%#llx\n",
+		       level, offset, pte, pte->val, dma_pte_present(pte),
+		       dma_pte_superpage(pte), dma_pte_addr(pte));
+
+		if (!dma_pte_present(pte) || level == 1 || dma_pte_superpage(pte))
+			break;
+
+		parent = phys_to_virt(dma_pte_addr(pte));
+		level--;
+	}
+}
+
+void dmar_fault_dump_ptes(struct intel_iommu *iommu, u16 source_id,
+			  unsigned long long addr, u32 pasid)
+{
+	if (!intel_iommu_debug_should_dump_source_id(source_id))
+		return;
+
+#ifdef CONFIG_DMAR_DEBUG
+	__dmar_fault_dump_ptes(iommu, source_id, addr, pasid);
+#else
+	struct context_entry *ctx_entry;
+	u8 devfn = source_id & 0xff;
+	u8 bus = source_id >> 8;
+	struct dma_pte *pgtable;
+
+	pr_info("Dump %s table entries for IOVA 0x%llx\n", iommu->name, addr);
+
+	if (!iommu->root_entry) {
+		pr_info("root table is not present\n");
+		return;
+	}
+
+	ctx_entry = iommu_context_addr(iommu, bus, devfn, 0);
+	if (!ctx_entry) {
+		pr_info("context table is not present\n");
+		return;
+	}
+
+	pr_info("context entry: hi 0x%016llx, low 0x%016llx\n",
+		ctx_entry->hi, ctx_entry->lo);
+
+	if (!sm_supported(iommu)) {
+		int level;
+		struct dma_pte *pte, *parent;
+		unsigned long pfn;
+
+		if (!context_present(ctx_entry)) {
+			pr_info("legacy mode page table is not present\n");
+			return;
+		}
+
+		pgtable = phys_to_virt(ctx_entry->lo & VTD_PAGE_MASK);
+		if (!pgtable) {
+			pr_info("legacy mode page table pointer is null\n");
+			return;
+		}
+
+		level = agaw_to_level(ctx_entry->hi & 7);
+		parent = pgtable;
+		pfn = addr >> VTD_PAGE_SHIFT;
+
+		pr_info("legacy mode page table root: %px level=%d\n", pgtable, level);
+		while (parent) {
+			int offset = pfn_level_offset(pfn, level);
+
+			pte = &parent[offset];
+			pr_info("pte level: %d offset: %d pte value: 0x%016llx\n",
+				level, offset, pte->val);
+
+			if (!dma_pte_present(pte)) {
+				pr_info("page table not present at level %d\n", level - 1);
+				return;
+			}
+
+			if (level == 1 || dma_pte_superpage(pte))
+				return;
+
+			parent = phys_to_virt(dma_pte_addr(pte));
+			level--;
+		}
+		return;
+	}
+
+	pr_info("non-debug scalable mode raw walk not implemented\n");
+#endif
+}
+
 static struct dma_pte *pfn_to_dma_pte(struct dmar_domain *domain,
 				      unsigned long pfn, int *target_level,
 				      gfp_t gfp)
@@ -3719,6 +3898,9 @@ static int intel_iommu_map(struct iommu_domain *domain,
 	/* Round up size to next multiple of PAGE_SIZE, if it and
 	   the low bits of hpa would take us onto the next page */
 	size = aligned_nrpages(hpa, size);
+	if (intel_iommu_debug_should_dump_domain(dmar_domain))
+		pr_err("DMAR debug: map domain=%px iova=%#lx hpa=%#llx pages=%#zx prot=%x\n",
+		       dmar_domain, iova, (unsigned long long)hpa, size, prot);
 	return __domain_mapping(dmar_domain, iova >> VTD_PAGE_SHIFT,
 				hpa >> VTD_PAGE_SHIFT, size, prot, gfp);
 }
@@ -3764,6 +3946,11 @@ static size_t intel_iommu_unmap(struct iommu_domain *domain,
 
 	start_pfn = iova >> VTD_PAGE_SHIFT;
 	last_pfn = (iova + size - 1) >> VTD_PAGE_SHIFT;
+	if (intel_iommu_debug_should_dump_domain(dmar_domain)) {
+		pr_err("DMAR debug: unmap domain=%px iova=%#lx size=%#zx level=%d start_pfn=%#lx last_pfn=%#lx\n",
+		       dmar_domain, iova, size, level, start_pfn, last_pfn);
+		intel_iommu_debug_dump_pte_chain(dmar_domain, iova);
+	}
 
 	domain_unmap(dmar_domain, start_pfn, last_pfn, &gather->freelist);
 
@@ -3794,7 +3981,14 @@ static size_t intel_iommu_unmap_pages(struct iommu_domain *domain,
 static void intel_iommu_tlb_sync(struct iommu_domain *domain,
 				 struct iommu_iotlb_gather *gather)
 {
-	cache_tag_flush_range(to_dmar_domain(domain), gather->start,
+	struct dmar_domain *dmar_domain = to_dmar_domain(domain);
+
+	if (intel_iommu_debug_should_dump_domain(dmar_domain))
+		pr_err("DMAR debug: tlb_sync domain=%px start=%#lx end=%#lx freelist_empty=%d\n",
+		       dmar_domain, gather->start, gather->end,
+		       list_empty(&gather->freelist));
+
+	cache_tag_flush_range(dmar_domain, gather->start,
 			      gather->end, list_empty(&gather->freelist));
 	iommu_put_pages_list(&gather->freelist);
 }
diff --git a/drivers/iommu/intel/iommu.h b/drivers/iommu/intel/iommu.h
index 6eabb4f60917..0e8ee04d4fd4 100644
--- a/drivers/iommu/intel/iommu.h
+++ b/drivers/iommu/intel/iommu.h
@@ -1284,6 +1284,9 @@ void cache_tag_flush_range(struct dmar_domain *domain, unsigned long start,
 void cache_tag_flush_all(struct dmar_domain *domain);
 void cache_tag_flush_range_np(struct dmar_domain *domain, unsigned long start,
 			      unsigned long end);
+void intel_iommu_debug_dump_pte_chain(struct dmar_domain *domain,
+				      unsigned long iova);
+bool intel_iommu_debug_should_dump_source_id(u16 source_id);
 
 void intel_context_flush_present(struct device_domain_info *info,
 				 struct context_entry *context,
diff --git a/include/linux/dmar.h b/include/linux/dmar.h
index 499bb2c63483..7c8769e71d11 100644
--- a/include/linux/dmar.h
+++ b/include/linux/dmar.h
@@ -126,13 +126,8 @@ static inline int dmar_res_noop(struct acpi_dmar_header *hdr, void *arg)
 	return 0;
 }
 
-#ifdef CONFIG_DMAR_DEBUG
 void dmar_fault_dump_ptes(struct intel_iommu *iommu, u16 source_id,
 			  unsigned long long addr, u32 pasid);
-#else
-static inline void dmar_fault_dump_ptes(struct intel_iommu *iommu, u16 source_id,
-					unsigned long long addr, u32 pasid) {}
-#endif
 
 #ifdef CONFIG_INTEL_IOMMU
 extern int iommu_detected, no_iommu;
-- 

+/// Builds HotPlugPci from VirtioInputResourceCarrier and InputLocalParameters.
+pub fn build_hotplug_input_device(
+    input_carrier_device: VirtioInputResourceCarrier,
+    input_local_parameters: InputLocalParameters,
+) -> Result<Box<dyn HotPluggable>> {
+    let pci_address = input_carrier_device
+        .pci_address
+        .context("PCI address not allocated")?;
+    let dev_file = open_file_or_duplicate(
+        &input_carrier_device.evdev_path,
+        OpenOptions::new().read(true).write(true),
+    )
+    .with_context(|| {
+        format!(
+            "open hotplug input evdev {}",
+            input_carrier_device.evdev_path.display()
+        )
+    })?;
+    let virtio_device = virtio::input::new_evdev(
+        dev_file,
+        virtio::base_features(input_local_parameters.protection_type),
+    )
+    .context("create virtio input device")?;
+    let mut virtio_pci_device = VirtioPciDevice::new(
+        input_local_parameters.guest_memory,
+        Box::new(virtio_device),
+        input_carrier_device.msi_device_tube,
+        true,
+        None,
+        input_carrier_device.ioevent_vm_memory_client,
+        input_carrier_device.vm_control_tube,
+    )
+    .context("create virtio PCI device")?;
+    virtio_pci_device
+        .set_pci_address(pci_address)
+        .context("set PCI address")?;
+    virtio_pci_device
+        .configure_io_bars()
+        .context("configure IO BAR")?;
+    virtio_pci_device
+        .configure_device_bars()
+        .context("configure device BAR")?;
+    let IntxParameter {
+        irq_evt,
+        irq_num,
+        pin,
+    } = input_carrier_device
+        .intx_parameter
+        .context("Missing INTx parameter.")?;
+    virtio_pci_device.assign_irq(irq_evt, pin, irq_num);
+    Ok(Box::new(virtio_pci_device))
+}

+#[cfg(feature = "pci-hotplug")]
+fn evdev_rdev(path: &Path) -> anyhow::Result<u64> {
+    let metadata = std::fs::metadata(path)
+        .with_context(|| format!("failed to stat evdev {}", path.display()))?;
+    Ok(metadata.rdev())
+}
+
+#[cfg(feature = "pci-hotplug")]
+fn add_hotplug_input<V: VmArch, Vcpu: VcpuArch>(
+    linux: &mut RunnableLinuxVm<V, Vcpu>,
+    sys_allocator: &mut SystemAllocator,
+    cfg: &Config,
+    add_control_tube: &mut impl FnMut(AnyControlTube),
+    hotplug_manager: &mut PciHotPlugManager,
+    evdev_path: &Path,
+) -> Result<u8> {
+    info!(
+        "creating hotplug virtio-input for evdev path {}",
+        evdev_path.display()
+    );
+
+    let new = evdev_rdev(evdev_path)?;
+    let has_boot_device = cfg.virtio_input.iter().any(|vi| {
+        if let InputDeviceOption::Evdev { path } = vi {
+            return match evdev_rdev(path) {
+                Ok(existing) => new == existing,
+                Err(e) => {
+                    warn!("{e}");
+                    false
+                }
+            };
+        }
+        false
+    });
+
+    let has_hotplugged_device = hotplug_manager
+        .hotplugged_devices()
+        .filter_map(|d| match d.device {
+            pci_hotplug_manager::HotplugDevice::Input(r) => Some(r.rdev),
+            _ => None,
+        })
+        .any(|rdev| rdev == new);
+
+    if has_boot_device || has_hotplugged_device {
+        bail!("Input evdev {} already exists", evdev_path.display());
+    }
+
+    let (msi_host_tube, msi_device_tube) = Tube::pair().context("create tube")?;
+    add_control_tube(AnyControlTube::IrqTube(msi_host_tube));
+    let (ioevent_host_tube, ioevent_device_tube) = Tube::pair().context("create tube")?;
+    let ioevent_vm_memory_client = VmMemoryClient::new(ioevent_device_tube);
+    add_control_tube(
+        VmMemoryTube {
+            tube: ioevent_host_tube,
+            expose_with_viommu: false,
+        }
+        .into(),
+    );
+    let (vm_control_host_tube, vm_control_device_tube) = Tube::pair().context("create tube")?;
+    add_control_tube(TaggedControlTube::Vm(vm_control_host_tube).into());
+    let input_carrier_device = VirtioInputResourceCarrier::new(
+        evdev_path.to_path_buf(),
+        msi_device_tube,
+        ioevent_vm_memory_client,
+        vm_control_device_tube,
+    );
+    let bus = hotplug_manager.hotplug_device(
+        vec![ResourceCarrier::VirtioInput(input_carrier_device)],
+        linux,
+        sys_allocator,
+    )?;
+    info!(
+        "hotplug virtio-input created for evdev path {} on pci bus {}",
+        evdev_path.display(),
+        bus
+    );
+    Ok(bus)
+}
+
+#[cfg(feature = "pci-hotplug")]
+fn handle_hotplug_input_command<V: VmArch, Vcpu: VcpuArch>(
+    input_cmd: InputControlCommand,
+    linux: &mut RunnableLinuxVm<V, Vcpu>,
+    sys_allocator: &mut SystemAllocator,
+    cfg: &Config,
+    add_control_tube: &mut impl FnMut(AnyControlTube),
+    hotplug_manager: &mut PciHotPlugManager,
+) -> VmResponse {
+    info!("received vm hotplug input command: {:?}", input_cmd);
+    match input_cmd {
+        InputControlCommand::AddEvdev { path } => add_hotplug_input(
+            linux,
+            sys_allocator,
+            cfg,
+            add_control_tube,
+            hotplug_manager,
+            path.as_path(),
+        )
+        .map_or_else(
+            |e| VmResponse::ErrString(format!("{e:?}")),
+            |bus| VmResponse::PciHotPlugResponse { bus },
+        ),
+        InputControlCommand::RemoveEvdev { bus } => {
+            handle_hotplug_remove(linux, sys_allocator, hotplug_manager, bus)
         }
     }
 }

From 0757db5a61d458f7722ccd000d23578cc0f7da75 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markku=20Ahvenj=C3=A4rvi?= <mankku@gmail.com>
Date: Tue, 9 Jun 2026 09:18:28 +0300
Subject: [PATCH 08/10] HACK: disable Intel GPU AML generation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Markku Ahvenjärvi <mankku@gmail.com>
---
 devices/src/pci/vfio_pci.rs | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/devices/src/pci/vfio_pci.rs b/devices/src/pci/vfio_pci.rs
index e1e7d61a0ede..353f231ed53c 100644
--- a/devices/src/pci/vfio_pci.rs
+++ b/devices/src/pci/vfio_pci.rs
@@ -2365,7 +2365,14 @@ impl PciDevice for VfioPciDevice {
                 // _DSM if there is none.
                 let acpi_path = self.sysfs_path.join("firmware_node/path");
                 if acpi_path.exists() {
-                    DsmMethod {}.to_aml_bytes(&mut amls);
+                    if self.is_intel_gfx() {
+                        info!(
+                            "{} skipping guest _DSM generation for Intel IGD experiment",
+                            self.debug_label()
+                        );
+                    } else {
+                        DsmMethod {}.to_aml_bytes(&mut amls);
+                    }
                 }
             }
         }

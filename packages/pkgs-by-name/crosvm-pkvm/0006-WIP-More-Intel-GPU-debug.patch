@@ -50,6 +50,7 @@ use crate::pci::acpi::DeviceVcfgRegister;
 use crate::pci::acpi::DsmMethod;
 use crate::pci::acpi::PowerResourceMethod;
 use crate::pci::acpi::SHM_OFFSET;

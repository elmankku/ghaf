 use crate::pci::msi::PCI_MSI_FLAGS;
@@ -2161,7 +2162,7 @@ impl PciDevice for VfioPciDevice {
                         }
                     };
                     info!("{} DSM request_len={}", self.debug_label(), dsm_len);
-                    let res = match self.device.acpi_dsm(&args[..dsm_len]) {
+                    let res = match self.device.acpi_dsm(&args[..dsm_len], SHM_SIZE as usize) {
                         Ok(r) => r,
                         Err(e) => {
                             error!(
diff --git a/devices/src/vfio.rs b/devices/src/vfio.rs
index 8e00fed512bd..26f895c9f94d 100644
--- a/devices/src/vfio.rs
+++ b/devices/src/vfio.rs
@@ -1246,15 +1246,17 @@ impl VfioDevice {
     }
 
     /// call _DSM from the device's ACPI table
-    pub fn acpi_dsm(&self, args: &[u8]) -> Result<Vec<u8>> {
-        let count = args.len();
+    pub fn acpi_dsm(&self, args: &[u8], out_len: usize) -> Result<Vec<u8>> {
+        let count = out_len.max(args.len());
         let mut dsm = vec_with_array_field::<vfio_acpi_dsm, u8>(count);
-        dsm[0].argsz = (mem::size_of::<vfio_acpi_dsm>() + mem::size_of_val(args)) as u32;
+        dsm[0].argsz = (mem::size_of::<vfio_acpi_dsm>() + count) as u32;
         dsm[0].padding = 0;
         // SAFETY:
-        // Safe as we allocated enough space to hold args
+        // Safe as we allocated enough space to hold the request prefix and any return payload.
         unsafe {
-            dsm[0].args.as_mut_slice(count).clone_from_slice(args);
+            let buf = dsm[0].args.as_mut_slice(count);
+            buf.fill(0);
+            buf[..args.len()].clone_from_slice(args);
         }
         // SAFETY:
         // Safe as we are the owner of self and dsm which are valid value

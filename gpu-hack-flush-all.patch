From b6679725388b4ff700f3444114efcdb750252da0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markku=20Ahvenj=C3=A4rvi?= <mankku@gmail.com>
Date: Fri, 26 Jun 2026 17:07:25 +0300
Subject: [PATCH] HACK: intel iGPU hacks
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Markku Ahvenjärvi <mankku@gmail.com>
---
 drivers/gpu/drm/i915/gt/uc/intel_uc_fw.c | 25 ++++++++++++++++++++++++
 drivers/iommu/intel/iommu.c              | 23 +++++++++++++++++-----
 2 files changed, 43 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/i915/gt/uc/intel_uc_fw.c b/drivers/gpu/drm/i915/gt/uc/intel_uc_fw.c
index e848a04a80dc..91fcfa64b95e 100644
--- a/drivers/gpu/drm/i915/gt/uc/intel_uc_fw.c
+++ b/drivers/gpu/drm/i915/gt/uc/intel_uc_fw.c
@@ -1085,6 +1085,7 @@ static int uc_fw_xfer(struct intel_uc_fw *uc_fw, u32 dst_offset, u32 dma_flags)
 {
 	struct intel_gt *gt = __uc_fw_to_gt(uc_fw);
 	struct intel_uncore *uncore = gt->uncore;
+	struct drm_i915_gem_object *obj = uc_fw->obj;
 	u64 offset;
 	int ret;
 
@@ -1094,6 +1095,27 @@ static int uc_fw_xfer(struct intel_uc_fw *uc_fw, u32 dst_offset, u32 dma_flags)
 
 	intel_uncore_forcewake_get(uncore, FORCEWAKE_ALL);
 
+	/*
+	 * The firmware object is already DMA-mapped, but for this debug path
+	 * force an explicit DMA sync immediately before GuC fetches from the
+	 * GGTT-backed source buffer.
+	 */
+	if (obj && obj->mm.pages)
+		dma_sync_sgtable_for_device(obj->base.dev->dev, obj->mm.pages,
+					    DMA_BIDIRECTIONAL);
+
+	if (uc_fw->rsa_data && uc_fw->rsa_data->obj &&
+	    uc_fw->rsa_data->obj->mm.pages)
+		dma_sync_sgtable_for_device(uc_fw->rsa_data->obj->base.dev->dev,
+					    uc_fw->rsa_data->obj->mm.pages,
+					    DMA_BIDIRECTIONAL);
+
+	/*
+	 * Make the GGTT PTE updates for the firmware source visible before the
+	 * GuC DMA engine fetches through the GGTT-backed address.
+	 */
+	intel_gt_flush_ggtt_writes(gt);
+
 	/* Set the source address for the uCode */
 	offset = uc_fw->vma_res.start + uc_fw->dma_start_offset;
 	GEM_BUG_ON(upper_32_bits(offset) & 0xFFFF0000);
@@ -1115,6 +1137,9 @@ static int uc_fw_xfer(struct intel_uc_fw *uc_fw, u32 dst_offset, u32 dma_flags)
 	intel_uncore_write_fw(uncore, DMA_CTRL,
 			      _MASKED_BIT_ENABLE(dma_flags | START_DMA));
 
+	/* Drain posted MMIO writes before polling DMA completion. */
+	intel_uncore_read_fw(uncore, DMA_CTRL);
+
 	/* Wait for DMA to finish */
 	ret = intel_wait_for_register_fw(uncore, DMA_CTRL, START_DMA, 0, 100, NULL);
 	if (ret)
diff --git a/drivers/iommu/intel/iommu.c b/drivers/iommu/intel/iommu.c
index 49e83c8566a3..db7e41698273 100644
--- a/drivers/iommu/intel/iommu.c
+++ b/drivers/iommu/intel/iommu.c
@@ -66,6 +66,7 @@ static int rwbf_quirk;
 static int force_on = 0;
 static int intel_iommu_tboot_noforce;
 static int no_platform_optin;
+static bool intel_iommu_debug_flush_all;
 
 #define ROOT_ENTRY_NR (VTD_PAGE_SIZE/sizeof(struct root_entry))
 
@@ -269,6 +270,9 @@ static int __init intel_iommu_setup(char *str)
 		} else if (!strncmp(str, "sm_off", 6)) {
 			pr_info("Scalable mode is disallowed\n");
 			intel_iommu_sm = 0;
+		} else if (!strncmp(str, "debug_flush_all", 15)) {
+			pr_info("Intel-IOMMU debug: force domain-wide IOTLB flushes\n");
+			intel_iommu_debug_flush_all = true;
 		} else if (!strncmp(str, "tboot_noforce", 13)) {
 			pr_info("Intel-IOMMU: not forcing on after tboot. This could expose security risk for tboot\n");
 			intel_iommu_tboot_noforce = 1;
@@ -3667,9 +3671,13 @@ static size_t intel_iommu_unmap_pages(struct iommu_domain *domain,
 static void intel_iommu_tlb_sync(struct iommu_domain *domain,
 				 struct iommu_iotlb_gather *gather)
 {
-	cache_tag_flush_range(to_dmar_domain(domain), gather->start,
-			      gather->end,
-			      iommu_pages_list_empty(&gather->freelist));
+	struct dmar_domain *dmar_domain = to_dmar_domain(domain);
+
+	if (intel_iommu_debug_flush_all)
+		cache_tag_flush_all(dmar_domain);
+	else
+		cache_tag_flush_range(dmar_domain, gather->start, gather->end,
+				      iommu_pages_list_empty(&gather->freelist));
 	iommu_put_pages_list(&gather->freelist);
 }
 
@@ -4050,8 +4058,13 @@ static int intel_iommu_iotlb_sync_map(struct iommu_domain *domain,
 {
 	struct dmar_domain *dmar_domain = to_dmar_domain(domain);
 
-	if (dmar_domain->iotlb_sync_map)
-		cache_tag_flush_range_np(dmar_domain, iova, iova + size - 1);
+	if (dmar_domain->iotlb_sync_map) {
+		if (intel_iommu_debug_flush_all)
+			cache_tag_flush_all(dmar_domain);
+		else
+			cache_tag_flush_range_np(dmar_domain, iova,
+						 iova + size - 1);
+	}
 
 	return 0;
 }
-- 
